# ==============================================================================
# OmniDownloader Pro - Environment Configuration (.env)
# ==============================================================================

PORT=4000
NODE_ENV=production

# 1. YOUTUBE COOKIES (BYPASS BOT DETECTION)
# YOUTUBE_COOKIES="# Netscape HTTP Cookie File\n.youtube.com\tTRUE\t..."
# YOUTUBE_COOKIES_PATH=./data/cookies.txt

# 2. PROXY SUPPORT (RESIDENTIAL / SOCKS5)
# PROXY_URL=http://username:password@proxy.example.com:8080

# 3. YT-DLP ENGINE
YTDLP_AUTO_UPDATE=true
YTDLP_EXTRACTOR_CLIENTS=android,ios,mweb,web
