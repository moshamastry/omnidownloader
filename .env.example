# ==============================================================================
# OmniDownloader Pro - Environment Configuration (.env)
# ==============================================================================

# Server Port and Node Environment
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. YOUTUBE BOT-DETECTION BYPASS (COOKIES CONFIGURATION)
# ------------------------------------------------------------------------------
# Option A: Paste full Netscape cookie text directly into this variable (Ideal for Render / Cloud)
# YOUTUBE_COOKIES="# Netscape HTTP Cookie File\n.youtube.com\tTRUE\t/\tTRUE\t..."

# Option B: Path to an exported cookies.txt file on disk
# YOUTUBE_COOKIES_PATH=./data/cookies.txt

# ------------------------------------------------------------------------------
# 2. RESIDENTIAL / DATACENTER PROXY SUPPORT (OPTIONAL)
# ------------------------------------------------------------------------------
# Supports HTTP, HTTPS, and SOCKS5 proxies (with or without user/pass authentication)
# PROXY_URL=http://username:password@residential-proxy.com:8080
# HTTP_PROXY=http://127.0.0.1:1080
# HTTPS_PROXY=http://127.0.0.1:1080

# ------------------------------------------------------------------------------
# 3. YT-DLP ENGINE SETTINGS
# ------------------------------------------------------------------------------
# Automatically check and update yt-dlp on server startup (true / false)
YTDLP_AUTO_UPDATE=true

# Extractor player clients for YouTube (order of fallback)
# Options: android, ios, mweb, web, tv_embedded, web_embedded
YTDLP_EXTRACTOR_CLIENTS=android,ios,mweb,web
